# 生产环境变量模板
# 部署时复制为根目录 .env 并填入真实值（.env 已被 gitignore，不会提交）：
#   cp .env.production.example .env

# ============ 必填 ============

# JWT 签名密钥（务必用强随机串，勿用开发值）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_SECRET=

# Fernet 加密密钥（用于加密用户自填的 LLM API Key）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_SECRET=

# ============ LLM（DeepSeek）平台默认配置 ============

# 平台兜底 Key：所有未填自己 Key 的用户都消耗此 Key 的余额，注意共享计费
# 留空则强制所有用户自带 Key（每个用户在自己的「AI 模型配置」里填写）
LLM_API_KEY=

LLM_INTERFACE_FORMAT=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=600

# ============ V3 P3-B 记忆分层 ============

# arc 章节数（每 N 章冻结一次 arc 摘要，摊薄 1/N；不设则默认 15）
ARC_SIZE=15

# ============ CORS ============

# 同源部署时前端由 Nginx 托管、/api 反代到后端，CORS 一般不触发
# 若前后端分离，则填前端实际域名（含 https://）
CORS_ORIGINS=http://localhost

# 说明：DATABASE_URL / REDIS_URL 已由 docker-compose.prod.yml 内部固定指向
# db / redis 服务，无需在此设置。
